<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="product.info.stock.sku">
            <block class="Magento\Catalog\Block\Product\View"
                   name="rokelzzz.product.copy.sku"
                   template="Rokezzz_ProductAdvance::product/view/copy_sku.phtml"
                   after="product.info.sku" />
        </referenceContainer>

        <referenceContainer name="product.info.main">
            <block class="Magento\Catalog\Block\Product\View"
                   name="rokelzzz.product.pdf.button"
                   template="Rokezzz_ProductAdvance::product/view/pdf_button.phtml"
                   after="rokelzzz.product.attributes.table" />
        </referenceContainer>
    </body>
</page>
