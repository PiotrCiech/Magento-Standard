<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="rokezzz_settings">
            <group id="loyalty_points" translate="label" sortOrder="50" showInDefault="1" showInWebsite="1"
                   showInStore="1">
                <label>Loyalty Points</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable loyalty points</label>
                    <comment>Allow customers to earn and redeem loyalty points on purchases.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="points_per_currency" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Points per currency unit</label>
                    <comment>Number of points awarded per 1 unit of order grand total (e.g. 1 = 1 point per 1 PLN).</comment>
                    <validate>validate-number validate-zero-or-greater</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="point_value" translate="label comment" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Point monetary value</label>
                    <comment>Store currency value of a single loyalty point (e.g. 0.01 = 1 point equals 0.01 PLN).</comment>
                    <validate>validate-number validate-zero-or-greater</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="min_points_to_redeem" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Minimum points to redeem</label>
                    <comment>Minimum number of points required to apply a discount at checkout.</comment>
                    <validate>validate-digits validate-zero-or-greater</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="max_redemption_percent" translate="label comment" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum redemption percent</label>
                    <comment>Maximum share of order grand total that can be paid with loyalty points (0-100).</comment>
                    <validate>validate-number validate-zero-or-greater</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
