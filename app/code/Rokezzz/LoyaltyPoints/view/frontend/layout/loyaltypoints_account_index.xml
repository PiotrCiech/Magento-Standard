<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <head>
        <title>Loyalty Points</title>
    </head>
    <body>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument name="title" xsi:type="string" translate="true">Loyalty Points</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="rokezzz.loyaltypoints.account"
                   template="Rokezzz_LoyaltyPoints::account/points.phtml"
                   cacheable="false">
                <arguments>
                    <argument name="view_model" xsi:type="object">Rokezzz\LoyaltyPoints\ViewModel\Account\Points</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
