        <plugin name="rokezzz_shipping_payment_filter_methods"
                type="Rokezzz\ShippingPayment\Plugin\Payment\MethodListPlugin"
                sortOrder="20"/>
    </type>
    <type name="Magento\Payment\Model\Method\AbstractMethod">
