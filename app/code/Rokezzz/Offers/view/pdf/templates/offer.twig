<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Offer {{ increment_id }}</title>
    <style>
        body {
            font-family: DejaVu Sans, sans-serif;
            font-size: 12px;
            color: #222;
        }

        h1 {
            font-size: 20px;
            margin-bottom: 8px;
        }

        .meta {
            margin-bottom: 20px;
        }

        .meta p {
            margin: 4px 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 16px;
        }

        th,
        td {
            border: 1px solid #ccc;
            padding: 8px;
            text-align: left;
        }

        th {
            background: #f5f5f5;
        }

        .total {
            margin-top: 16px;
            text-align: right;
            font-size: 14px;
            font-weight: bold;
        }

        .notes {
            margin-top: 24px;
        }

        .notes h2 {
            font-size: 14px;
            margin-bottom: 8px;
        }

        .platform-signature {
            margin-top: 24px;
            padding-top: 12px;
            border-top: 1px solid #eee;
            font-size: 10px;
            color: #888;
            text-align: center;
        }
    </style>
</head>
<body>
    <h1>Offer {{ increment_id }}</h1>

    <div class="meta">
        {% if customer_name %}
            <p><strong>Customer:</strong> {{ customer_name }}</p>
        {% endif %}
        {% if expires_at %}
            <p><strong>Valid until:</strong> {{ expires_at }}</p>
        {% else %}
            <p><strong>Valid until:</strong> Available indefinitely</p>
        {% endif %}
    </div>

    <table>
        <thead>
            <tr>
                <th>SKU</th>
                <th>Product</th>
                <th>Qty</th>
                <th>Price</th>
                <th>Line total</th>
            </tr>
        </thead>
        <tbody>
            {% for item in items %}
                <tr>
                    <td>{{ item.sku }}</td>
                    <td>{{ item.name }}</td>
                    <td>{{ item.qty }}</td>
                    <td>{{ item.price }}</td>
                    <td>{{ item.line_total }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="total">
        Total: {{ total }}
    </div>

    {% if customer_note %}
        <div class="notes">
            <h2>Customer note</h2>
            <p>{{ customer_note }}</p>
        </div>
    {% endif %}

    {% if admin_note %}
        <div class="notes">
            <h2>Store note</h2>
            <p>{{ admin_note }}</p>
        </div>
    {% endif %}

    {% if platform_signature %}
        <div class="platform-signature">
            {{ platform_signature }}
        </div>
    {% endif %}
</body>
</html>
