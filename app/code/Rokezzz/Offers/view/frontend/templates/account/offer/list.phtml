<?php
/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \Rokezzz\Offers\ViewModel\Account\OfferList $viewModel */
$viewModel = $block->getData('view_model');
$offers = $viewModel->getOffers();
?>
<div class="block block-rokezzz-offers">
    <div class="block-title">
        <strong><?= $escaper->escapeHtml(__('My Offers')) ?></strong>
    </div>
    <div class="block-content">
        <?php if ($offers === []): ?>
            <p><?= $escaper->escapeHtml(__('You do not have any offers yet.')) ?></p>
        <?php else: ?>
            <table class="data table table-rokezzz-offers" id="rokezzz-offer-list">
                <thead>
                    <tr>
                        <th scope="col" class="col number"><?= $escaper->escapeHtml(__('Offer Number')) ?></th>
                        <th scope="col" class="col status"><?= $escaper->escapeHtml(__('Status')) ?></th>
                        <th scope="col" class="col expires"><?= $escaper->escapeHtml(__('Valid Until')) ?></th>
                        <th scope="col" class="col actions"><?= $escaper->escapeHtml(__('Actions')) ?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($offers as $offer): ?>
                        <tr>
                            <td data-th="<?= $escaper->escapeHtmlAttr(__('Offer Number')) ?>">
                                <?= $escaper->escapeHtml($offer->getIncrementId()) ?>
                            </td>
                            <td data-th="<?= $escaper->escapeHtmlAttr(__('Status')) ?>">
                                <span class="rokezzz-status <?= $escaper->escapeHtmlAttr($viewModel->getStatusClass($offer)) ?>">
                                    <?= $escaper->escapeHtml($viewModel->getStatusLabel($offer)) ?>
                                </span>
                            </td>
                            <td data-th="<?= $escaper->escapeHtmlAttr(__('Valid Until')) ?>">
                                <?= $escaper->escapeHtml($viewModel->getExpirationLabel($offer)) ?>
                            </td>
                            <td data-th="<?= $escaper->escapeHtmlAttr(__('Actions')) ?>" class="col actions">
                                <div class="rokezzz-offer-actions-inline">
                                    <a class="action view" href="<?= $escaper->escapeUrl($viewModel->getViewUrl($offer)) ?>">
                                        <?= $escaper->escapeHtml(__('View')) ?>
                                    </a>
                                    <?php if ($viewModel->canApply($offer)): ?>
                                        <form action="<?= $escaper->escapeUrl($viewModel->getApplyUrl($offer)) ?>"
                                              method="post"
                                              class="form offer-apply-form">
                                            <?= $block->getBlockHtml('formkey') ?>
                                            <button type="submit" class="action primary">
                                                <span><?= $escaper->escapeHtml(__('Use Offer')) ?></span>
                                            </button>
                                        </form>
                                    <?php endif; ?>
                                </div>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
        <?php endif; ?>
    </div>
</div>
