<?php
/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \Rokezzz\Offers\ViewModel\Checkout\CartQuoteRequest $viewModel */
$viewModel = $block->getData('view_model');
?>
<?php if ($viewModel->hasQuoteRequestItems()): ?>
    <div class="block block-rokezzz-cart-quote-request">
        <div class="block-title">
            <strong><?= $escaper->escapeHtml(__('Quote Request Items')) ?></strong>
        </div>
        <div class="block-content">
            <p><?= $escaper->escapeHtml(__('The following out-of-stock products are held for a quote request and cannot be purchased at checkout.')) ?></p>
            <ul class="rokezzz-quote-request-items">
                <?php foreach ($viewModel->getQuoteRequestItems() as $item): ?>
                    <li>
                        <?= $escaper->escapeHtml($item->getName()) ?>
                        (<?= $escaper->escapeHtml(__('SKU')) ?>: <?= $escaper->escapeHtml($item->getSku()) ?>)
                        — <?= $escaper->escapeHtml(__('Qty')) ?>: <?= $escaper->escapeHtml((string) $item->getQty()) ?>
                    </li>
                <?php endforeach; ?>
            </ul>
            <?php if ($viewModel->hasRegularItems()): ?>
                <p class="rokezzz-quote-request-hint">
                    <?= $escaper->escapeHtml(__('Submit the quote request first, then you can proceed to checkout with the remaining items.')) ?>
                </p>
            <?php else: ?>
                <p class="rokezzz-quote-request-hint">
                    <?= $escaper->escapeHtml(__('Submit the quote request to continue shopping or wait for our offer.')) ?>
                </p>
            <?php endif; ?>
            <form action="<?= $escaper->escapeUrl($viewModel->getSubmitUrl()) ?>"
                  method="post"
                  class="form quote-request-submit-form">
                <?= $block->getBlockHtml('formkey') ?>
                <div class="field note">
                    <label class="label" for="rokezzz-quote-request-note">
                        <span><?= $escaper->escapeHtml(__('Your Note')) ?></span>
                    </label>
                    <div class="control">
                        <textarea name="customer_note"
                                  id="rokezzz-quote-request-note"
                                  rows="3"
                                  class="input-text"
                                  placeholder="<?= $escaper->escapeHtmlAttr(__('Optional note for the store team')) ?>"></textarea>
                    </div>
                </div>
                <div class="rokezzz-quote-request-actions">
                    <button type="submit" class="action primary">
                        <span><?= $escaper->escapeHtml(__('Submit Quote Request')) ?></span>
                    </button>
                    <a class="action" href="<?= $escaper->escapeUrl($viewModel->getHistoryUrl()) ?>">
                        <?= $escaper->escapeHtml(__('View Quote Request History')) ?>
                    </a>
                </div>
            </form>
        </div>
    </div>
    <script type="text/x-magento-init">
    {
        ".cart-container": {
            "Rokezzz_Offers/js/cart-quote-request": {
                "hasQuoteRequestItems": true,
                "checkoutBlockedMessage": <?= /* @noEscape */ json_encode($viewModel->getCheckoutBlockedMessage()) ?>
            }
        }
    }
    </script>
<?php endif; ?>
