<?php

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Rokezzz\Analytics\ViewModel\Tracking;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var Tracking $viewModel */
$viewModel = $block->getViewModel();

if (!$viewModel->isGtmActive()) {
    return;
}

$containerId = $viewModel->getTrackingId();
?>
<!-- Google Tag Manager (noscript) -->
<noscript>
    <iframe src="https://www.googletagmanager.com/ns.html?id=<?= $escaper->escapeHtmlAttr($containerId) ?>"
            height="0"
            width="0"
            style="display:none;visibility:hidden"></iframe>
</noscript>
<!-- End Google Tag Manager (noscript) -->
