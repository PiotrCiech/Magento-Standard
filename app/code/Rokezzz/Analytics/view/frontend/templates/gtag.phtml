<?php

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Rokezzz\Analytics\ViewModel\Tracking;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var Tracking $viewModel */
$viewModel = $block->getViewModel();

if (!$viewModel->isGtagActive()) {
    return;
}

$trackingId = $viewModel->getTrackingId();
?>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=<?= $escaper->escapeHtmlAttr($trackingId) ?>"></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<?= $escaper->escapeJs($trackingId) ?>');
</script>
