<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <move element="catalog.compare.sidebar" destination="sidebar.main" after="catalog.leftnav"/>
        <move element="wishlist_sidebar" destination="sidebar.main" after="catalog.compare.sidebar"/>
        <referenceContainer name="sidebar.main">
            <block class="Rokezzz\CategoryAdvance\Block\Catalog\DownloadButton"
                   name="rokezzz.categoryadvance.pdf.download"
                   template="Rokezzz_CategoryAdvance::catalog/download-button.phtml"
                   after="wishlist_sidebar"/>
        </referenceContainer>
    </body>
</page>
