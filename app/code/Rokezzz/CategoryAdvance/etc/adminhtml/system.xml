<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="rokezzz_categoryadvance" translate="label" sortOrder="910" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Rokezzz Category Advance</label>
            <tab>general</tab>
            <resource>Rokezzz_CategoryAdvance::config</resource>
            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General Settings</label>
                <field id="enable_pdf_catalog" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable category PDF catalog</label>
                    <comment>When disabled, the download button is hidden on category pages.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
