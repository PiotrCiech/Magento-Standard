<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="rokezzz_contract_withdrawal_request" resource="default" engine="innodb"
           comment="Rokezzz Contract Withdrawal Request">
        <column xsi:type="int" name="entity_id" identity="true" unsigned="true" nullable="false"
                comment="Entity ID"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false"
                comment="Order ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false"
                comment="Customer ID"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="requested"
                comment="Withdrawal Status"/>
        <column xsi:type="text" name="statement_text" nullable="false"
                comment="Withdrawal Statement Text"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"
                on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP"
                on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ROKEZZZ_CW_REQUEST_ORDER_ID_SALES_ORDER_ENTITY_ID"
                    table="rokezzz_contract_withdrawal_request" column="order_id"
                    referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="ROKEZZZ_CW_REQUEST_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="rokezzz_contract_withdrawal_request" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="unique" referenceId="ROKEZZZ_CW_REQUEST_ORDER_ID_UNIQUE">
            <column name="order_id"/>
        </constraint>
        <index referenceId="ROKEZZZ_CW_REQUEST_CUSTOMER_ID_STATUS" indexType="btree">
            <column name="customer_id"/>
            <column name="status"/>
        </index>
    </table>
</schema>
