<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Checkout\Model\ShippingInformationManagement">
        <plugin name="rokezzz_delivery_date_save_on_shipping"
                type="Rokezzz\DeliveryDate\Plugin\Checkout\ShippingInformationManagementPlugin"/>
    </type>
    <type name="Magento\Checkout\Model\PaymentInformationManagement">
        <plugin name="rokezzz_delivery_date_save_on_payment"
                type="Rokezzz\DeliveryDate\Plugin\Checkout\PaymentInformationManagementPlugin"/>
    </type>
    <type name="Magento\Checkout\Model\GuestPaymentInformationManagement">
        <plugin name="rokezzz_delivery_date_save_on_guest_payment"
                type="Rokezzz\DeliveryDate\Plugin\Checkout\GuestPaymentInformationManagementPlugin"/>
    </type>
    <type name="Magento\Quote\Model\QuoteManagement">
        <plugin name="rokezzz_delivery_date_validate_on_place_order"
                type="Rokezzz\DeliveryDate\Plugin\Quote\QuoteManagementPlugin"/>
    </type>
</config>
