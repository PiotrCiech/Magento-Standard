<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">rokezzz_blog_author_listing.rokezzz_blog_author_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>rokezzz_blog_author_columns</spinner>
        <deps>
            <dep>rokezzz_blog_author_listing.rokezzz_blog_author_listing_data_source</dep>
        </deps>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Author</label>
            </button>
        </buttons>
    </settings>
    <dataSource name="rokezzz_blog_author_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
            <storageConfig>
                <param name="indexField" xsi:type="string">author_id</param>
            </storageConfig>
        </settings>
        <aclResource>Rokezzz_Blog::authors</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="rokezzz_blog_author_listing_data_source">
            <settings>
                <requestFieldName>author_id</requestFieldName>
                <primaryFieldName>author_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <massaction name="listing_massaction" component="Magento_Ui/js/grid/tree-massactions">
            <action name="delete">
                <settings>
                    <url path="rokezzz_blog/author/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                    <confirm>
                        <title translate="true">Delete Authors</title>
                        <message translate="true">Are you sure you want to delete the selected authors?</message>
                    </confirm>
                </settings>
            </action>
        </massaction>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="rokezzz_blog_author_columns">
        <selectionsColumn name="ids" sortOrder="0">
            <settings>
                <indexField>author_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="author_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="firstname" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">First Name</label>
            </settings>
        </column>
        <column name="lastname" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Last Name</label>
            </settings>
        </column>
        <column name="job_title" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Job Title</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="50">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created At</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Rokezzz\Blog\Ui\Component\Listing\Column\AuthorActions" sortOrder="100">
            <settings>
                <indexField>author_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
