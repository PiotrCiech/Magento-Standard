<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="rokezzz_omnibus_price_history" resource="default" engine="innodb"
           comment="Omnibus gross final price history for simple products">
        <column xsi:type="int" name="history_id" unsigned="true" nullable="false" identity="true"
                comment="History ID"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false" comment="Product ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store ID"/>
        <column xsi:type="decimal" name="price" scale="4" precision="12" unsigned="false" nullable="false"
                comment="Gross final price"/>
        <column xsi:type="timestamp" name="recorded_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Recorded at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="history_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ROKEZZZ_OMNIBUS_PRODUCT_ID_CATALOG_PRODUCT_ENTITY_ENTITY_ID"
                    table="rokezzz_omnibus_price_history" column="product_id"
                    referenceTable="catalog_product_entity" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
        <index referenceId="ROKEZZZ_OMNIBUS_PRODUCT_STORE_RECORDED" indexType="btree">
            <column name="product_id"/>
            <column name="store_id"/>
            <column name="recorded_at"/>
        </index>
    </table>
</schema>
