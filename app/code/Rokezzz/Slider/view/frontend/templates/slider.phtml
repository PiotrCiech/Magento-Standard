<?php

use Rokezzz\Slider\Block\Slider;

/** @var Slider $block */

if (!$block->hasSlides()) {
    return;
}

$slides = $block->getSlides();
$uniqueId = $block->getUniqueId();
?>

<div class="promotion-slider" id="<?= $block->escapeHtmlAttr($uniqueId) ?>">
    <div class="slider-container">
        <div class="slider-wrapper">
            <?php foreach ($slides as $index => $slide): ?>
            <div class="slide" data-slide-index="<?= $index ?>">
                <?php $imageUrl = $block->getImageUrl($slide['image']); ?>
                <?php if ($imageUrl): ?>
                <div class="slide-image">
                    <img src="<?= $block->escapeUrl($imageUrl) ?>"
                        alt="<?= $block->escapeHtmlAttr($slide['title']) ?>" />
                </div>
                <?php endif; ?>
                <div class="slide-content">
                    <div class="slide-title">
                        <h1><?= nl2br($block->escapeHtml($slide['title'])) ?></h1>
                        <div class="slide-buttons">
                            <?php if (!empty($slide['btn_left_label'])): ?>
                            <?php if (!empty($slide['btn_left_url'])): ?>
                            <a href="<?= $block->escapeUrl($slide['btn_left_url']) ?>" class="slide-btn left"
                                target="_blank"><?= $block->escapeHtml($slide['btn_left_label']) ?></a>
                            <?php else: ?>
                            <span class="slide-btn left"><?= $block->escapeHtml($slide['btn_left_label']) ?></span>
                            <?php endif; ?>
                            <?php endif; ?>
                            <?php if (!empty($slide['btn_right_label'])): ?>
                            <?php if (!empty($slide['btn_right_url'])): ?>
                            <a href="<?= $block->escapeUrl($slide['btn_right_url']) ?>" class="slide-btn right"
                                target="_blank"><?= $block->escapeHtml($slide['btn_right_label']) ?></a>
                            <?php else: ?>
                            <span class="slide-btn right"><?= $block->escapeHtml($slide['btn_right_label']) ?></span>
                            <?php endif; ?>
                            <?php endif; ?>
                        </div>
                    </div>
                    <div class="slide-numbers">
                        <?php if (!empty($slide['counter_left_label']) || !empty($slide['counter_left_number'])): ?>
                        <div class="slide-counter">
                            <?php if (!empty($slide['counter_left_number'])): ?>
                            <span class="number"><?= $block->escapeHtml($slide['counter_left_number']) ?></span>
                            <?php endif; ?>
                            <?php if (!empty($slide['counter_left_label'])): ?>
                            <span class="label"><?= $block->escapeHtml($slide['counter_left_label']) ?></span>
                            <?php endif; ?>
                        </div>
                        <?php endif; ?>
                        <?php if (!empty($slide['counter_right_label']) || !empty($slide['counter_right_number'])): ?>
                        <div class="slide-counter">
                            <?php if (!empty($slide['counter_right_number'])): ?>
                            <span class="number"><?= $block->escapeHtml($slide['counter_right_number']) ?></span>
                            <?php endif; ?>
                            <?php if (!empty($slide['counter_right_label'])): ?>
                            <span class="label"><?= $block->escapeHtml($slide['counter_right_label']) ?></span>
                            <?php endif; ?>
                        </div>
                        <?php endif; ?>
                    </div>
                </div>
                <div class="overlay"></div>
            </div>
            <?php endforeach; ?>
        </div>
    </div>

    <?php if ($block->showDots()): ?>
    <div class="slider-dots">
        <?php foreach ($slides as $index => $slide): ?>
        <button class="dot <?= $index === 0 ? 'active first' : ($index === count($slides) - 1 ? 'last' : '') ?>"
            data-slide-index="<?= $index ?>"
            aria-label="<?= $block->escapeHtmlAttr(__('Go to slide %1', $index + 1)) ?>">
        </button>
        <?php endforeach; ?>
    </div>
    <?php endif; ?>
</div>

<script type="text/x-magento-init">
    {
    "#<?= $block->escapeJs($uniqueId) ?>": {
        "Rokezzz_Slider/js/slider": {
            "autoplay": <?= $block->isAutoplay() ? 'true' : 'false' ?>,
            "autoplaySpeed": <?= (int) $block->getAutoplaySpeed() ?>,
            "animationSpeed": <?= (int) $block->getAnimationSpeed() ?>,
            "showArrows": <?= $block->showArrows() ? 'true' : 'false' ?>,
            "showDots": <?= $block->showDots() ? 'true' : 'false' ?>
        }
    }
}
</script>
