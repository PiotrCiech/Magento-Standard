<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">rokezzz_slider_slide_listing.rokezzz_slider_slide_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>rokezzz_slider_slide_columns</spinner>
        <deps>
            <dep>rokezzz_slider_slide_listing.rokezzz_slider_slide_listing_data_source</dep>
        </deps>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Slide</label>
            </button>
        </buttons>
    </settings>
    <dataSource name="rokezzz_slider_slide_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
            <storageConfig>
                <param name="indexField" xsi:type="string">slide_id</param>
            </storageConfig>
        </settings>
        <aclResource>Rokezzz_Slider::slide</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="rokezzz_slider_slide_listing_data_source">
            <settings>
                <requestFieldName>slide_id</requestFieldName>
                <primaryFieldName>slide_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <massaction name="listing_massaction" component="Magento_Ui/js/grid/tree-massactions">
            <action name="delete">
                <settings>
                    <url path="rokezzz_slider/slide/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                    <confirm>
                        <title translate="true">Delete Slides</title>
                        <message translate="true">Are you sure you want to delete the selected slides?</message>
                    </confirm>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="rokezzz_slider_slide_columns">
        <selectionsColumn name="ids" sortOrder="0">
            <settings>
                <indexField>slide_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="slide_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="title" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Title</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="image" class="Rokezzz\Slider\Ui\Component\Listing\Column\Thumbnail" component="Magento_Ui/js/grid/columns/thumbnail" sortOrder="30">
            <settings>
                <altField>title</altField>
                <hasPreview>true</hasPreview>
                <label translate="true">Image</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="sort_order" sortOrder="50">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Sort Order</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="is_active" component="Magento_Ui/js/grid/columns/select" sortOrder="60">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Active</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="70">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created At</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <actionsColumn name="actions" class="Rokezzz\Slider\Ui\Component\Listing\Column\SlideActions" sortOrder="100">
            <settings>
                <indexField>slide_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
