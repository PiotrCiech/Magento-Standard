<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Rokezzz\CatalogListing\Api\ListingFragmentRendererInterface"
                type="Rokezzz\CatalogListing\Model\ListingFragmentRenderer"/>
    <type name="Magento\Catalog\Model\Layer\FilterList">
        <plugin name="rokezzz_cataloglisting_unique_filters"
                type="Rokezzz\CatalogListing\Plugin\Catalog\Layer\FilterListUniqueFiltersPlugin"/>
    </type>
    <type name="Magento\Catalog\Model\Layer\State">
        <plugin name="rokezzz_cataloglisting_unique_state_filters"
                type="Rokezzz\CatalogListing\Plugin\Catalog\Layer\StateDuplicateFilterPlugin"/>
    </type>
</config>
