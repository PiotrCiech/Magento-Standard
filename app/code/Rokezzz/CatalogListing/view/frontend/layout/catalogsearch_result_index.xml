<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <container name="rokezzz.listing.root"
                       htmlTag="div"
                       htmlClass="rokezzz-listing-root"
                       htmlId="rokezzz-listing-root"
                       before="-"/>
        </referenceContainer>
        <move element="search.result" destination="rokezzz.listing.root"/>
        <referenceContainer name="before.body.end">
            <block class="Rokezzz\CatalogListing\Block\ListingConfig"
                   name="rokezzz.catalog.listing.config.search"
                   template="Rokezzz_CatalogListing::listing-config.phtml"
                   cacheable="false">
                <arguments>
                    <argument name="listing_type" xsi:type="string">search</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
