<?php
/** @var \Rokezzz\Core\Block\PromotedCategories $block */
$categories = $block->getPromotedCategories();
?>

<?php if ($categories->getSize()): ?>
    <?php $hasImages = $block->isShowImagesEnabled(); ?>
    <div class="promoted-categories promoted-categories--<?= $hasImages ? 'image' : 'text' ?>">
        <div class="promoted-categories__grid">
            <?php foreach ($categories as $category): ?>
                <a href="<?= $block->escapeUrl($category->getUrl()) ?>" class="promoted-categories__item">
                    <?php if ($hasImages): ?>
                        <div class="promoted-categories__image-wrapper">
                            <?php $imageUrl = $category->getImageUrl(); ?>
                            <?php if ($imageUrl): ?>
                                <img src="<?= $block->escapeUrl($imageUrl) ?>" alt="<?= $block->escapeHtmlAttr($category->getName()) ?>"
                                    class="promoted-categories__image">
                            <?php endif; ?>
                        </div>
                        <div class="promoted-categories__content">
                            <span class="promoted-categories__title">
                                <?= $block->escapeHtml($category->getName()) ?>
                            </span>
                        </div>
                    <?php else: ?>
                        <span class="promoted-categories__title">
                            <?= $block->escapeHtml($category->getName()) ?>
                        </span>
                    <?php endif; ?>
                </a>
            <?php endforeach; ?>
        </div>
    </div>
<?php endif; ?>
