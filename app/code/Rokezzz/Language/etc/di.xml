<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\App\Language\Dictionary">
        <plugin name="rokezzz_language_merge_area_dictionaries"
                type="Rokezzz\Language\Plugin\Framework\App\Language\DictionaryPlugin"/>
    </type>
    <type name="Magento\Catalog\Model\Category\DataProvider">
        <plugin name="rokezzz_language_translate_category_form_meta"
                type="Rokezzz\Language\Plugin\Catalog\Model\Category\DataProviderPlugin"/>
    </type>
    <type name="Magento\Customer\Ui\Component\Listing\Column\Group\Options">
        <plugin name="rokezzz_language_translate_customer_group_options"
                type="Rokezzz\Language\Plugin\Customer\Ui\Component\Listing\Column\Group\OptionsPlugin"/>
    </type>
    <type name="Magento\Tax\Model\TaxClass\Source\Customer">
        <plugin name="rokezzz_language_translate_customer_tax_class_options"
                type="Rokezzz\Language\Plugin\Tax\Model\TaxClass\Source\CustomerPlugin"/>
    </type>
    <type name="Magento\Customer\Model\Customer\Attribute\Source\Group">
        <plugin name="rokezzz_language_translate_customer_form_group_options"
                type="Rokezzz\Language\Plugin\Customer\Model\Customer\Attribute\Source\GroupPlugin"/>
    </type>
    <type name="Magento\Theme\Block\Html\Title">
        <plugin name="rokezzz_language_translate_raw_page_titles"
                type="Rokezzz\Language\Plugin\Theme\Block\Html\TitlePlugin"/>
    </type>
</config>
