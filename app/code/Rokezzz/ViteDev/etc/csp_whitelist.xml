<?xml version="1.0" encoding="UTF-8"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="vite_dev_client" type="host">http://localhost:5173</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="vite_dev_http" type="host">http://localhost:5173</value>
                <value id="vite_dev_ws" type="host">ws://localhost:5173</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
