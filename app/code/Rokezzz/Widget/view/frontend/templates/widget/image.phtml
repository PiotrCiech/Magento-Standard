<?php
declare(strict_types=1);

use Rokezzz\Widget\Block\Widget\Image;

/** @var Image $block */
$imageUrl = $block->getImageUrl();
$altText = $block->escapeHtml($block->getData('alt_text'));
$linkUrl = $block->escapeUrl($block->getData('link_url'));

if (!$imageUrl) {
    return;
}
?>

<div class="rokezzz-image-widget-container">
    <?php if ($linkUrl): ?>
    <a href="<?= $linkUrl ?>" title="<?= $altText ?>" class="rokezzz-image-link">
        <?php endif; ?>

        <img src="<?= $imageUrl ?>" alt="<?= $altText ?>" class="rokezzz-widget-img" loading="lazy" />

        <?php if ($linkUrl): ?>
    </a>
    <?php endif; ?>
</div>
