<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Checkout\Model\DefaultConfigProvider">
        <plugin name="rokezzz_order_advance_checkout_config"
                type="Rokezzz\OrderAdvance\Plugin\Checkout\DefaultConfigProviderPlugin"/>
    </type>
    <type name="Magento\Checkout\Block\Checkout\LayoutProcessor">
        <plugin name="rokezzz_order_advance_checkout_layout"
                type="Rokezzz\OrderAdvance\Plugin\Checkout\LayoutProcessorPlugin"/>
    </type>
    <type name="Magento\Customer\CustomerData\SectionPoolInterface">
        <arguments>
            <argument name="sectionSourceMap" xsi:type="array">
                <item name="rokezzz-latest-order-status" xsi:type="string">Rokezzz\OrderAdvance\CustomerData\LatestOrderStatus</item>
            </argument>
        </arguments>
    </type>
</config>
