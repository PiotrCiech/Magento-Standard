<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="rokezzz_order_advance" translate="label" sortOrder="975" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Rokezzz Order Advance</label>
            <tab>general</tab>
            <resource>Rokezzz_OrderAdvance::config</resource>
            <group id="order_number" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Customer order number</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable customer order number</label>
                    <comment>When enabled, customers can provide their own order number during checkout.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="label" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Field label</label>
                    <comment>Label displayed above the order number field in checkout.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="placeholder" translate="label" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Field placeholder</label>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="max_length" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum length</label>
                    <comment>Maximum number of characters accepted in the customer order number field.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="status_bar" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Latest order status bar</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable latest order status bar</label>
                    <comment>When enabled, logged in customers see a bar with the status of their latest order at the top of the page.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="visible_days" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Visible for days</label>
                    <comment>The bar is shown only when the latest order was placed within this number of days.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
