<?php
/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Rokezzz\OrderAdvance\ViewModel\StatusBar $statusBarViewModel */
$statusBarViewModel = $block->getData('status_bar_view_model');

if (!$statusBarViewModel->isEnabled()) {
    return;
}
?>
<div class="latest-order-status-bar" data-bind="scope: 'rokezzzLatestOrderStatusBar'">
    <div class="latest-order-status-bar__bar"
         data-bind="css: {'latest-order-status-bar__bar--active': isVisible()}">
        <div class="latest-order-status-bar__content">
            <span class="latest-order-status-bar__message">
                <?= $block->escapeHtml(__('Your order')) ?>
                <a class="latest-order-status-bar__link" data-bind="attr: {href: orderUrl()}">
                    <span data-bind="text: '#' + incrementId()"></span>
                </a>
            </span>
            <span class="latest-order-status-bar__status">
                <span class="latest-order-status-bar__status-label" data-bind="text: statusLabel()"></span>
            </span>
        </div>
    </div>
</div>
<script type="text/x-magento-init">
{
    ".latest-order-status-bar": {
        "Magento_Ui/js/core/app": {
            "components": {
                "rokezzzLatestOrderStatusBar": {
                    "component": "Rokezzz_OrderAdvance/js/view/latest-order-status-bar"
                }
            }
        }
    }
}
</script>
