<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_order_save_after">
        <observer name="rokezzz_loyalty_points_award_on_complete"
                  instance="Rokezzz\LoyaltyPoints\Observer\AwardPointsOnOrderComplete"/>
    </event>
    <event name="sales_order_place_after">
        <observer name="rokezzz_loyalty_points_redeem_on_place"
                  instance="Rokezzz\LoyaltyPoints\Observer\RedeemPointsOnOrderPlace"/>
    </event>
    <event name="order_cancel_after">
        <observer name="rokezzz_loyalty_points_refund_on_cancel"
                  instance="Rokezzz\LoyaltyPoints\Observer\RefundPointsOnOrderCancel"/>
    </event>
</config>
