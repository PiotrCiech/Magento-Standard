<?php
declare(strict_types=1);

use Rokezzz\Gallery\Block\Adminhtml\Widget\GalleryRows;

/** @var GalleryRows $block */

$element = $block->getElement();
$elementId = $element->getHtmlId();
$value = $element->getValue();
?>

<div class="rokezzz-gallery-admin-container" id="gallery-container-<?= $elementId ?>">
    <input type="hidden" id="<?= $elementId ?>" name="<?= $element->getName() ?>"
        value="<?= $block->escapeHtmlAttr($value) ?>" class="widget-option" />

    <table class="admin__control-table">
        <thead>
            <tr>
                <th style="width: 45%;"><?= __('Zdjęcie') ?></th>
                <th style="width: 45%;"><?= __('Opis / Podpis') ?></th>
                <th style="width: 10%; text-align: center;"><?= __('Akcja') ?></th>
            </tr>
        </thead>
        <tbody id="gallery-rows-tbody-<?= $elementId ?>">
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="col-actions">
                    <button type="button" class="action-add" id="add-row-btn-<?= $elementId ?>">
                        <span><?= __('Dodaj zdjęcie do galerii') ?></span>
                    </button>
                </td>
            </tr>
        </tfoot>
    </table>
</div>

<script>
require(['jquery', 'mage/adminhtml/browser'], function($) {
    const elementId = '<?= $elementId ?>',
        hiddenInput = $('#' + elementId),
        tbody = $('#gallery-rows-tbody-' + elementId),
        mediaUrlTemplate = '<?= $block->getMediaBrowserUrl('__TARGET_ID__') ?>';

    $('#gallery-container-' + elementId)
        .closest('.admin__field-control')
        .find('.control-value')
        .hide();

    let currentData = [];

    try {
        const rawValue = hiddenInput.val();

        if (rawValue) {
            currentData = JSON.parse(rawValue);
        }
    } catch (e) {
        console.error("Błąd parsowania danych galerii: ", e);
    }

    const generateUniqueId = () => 'img_' + Math.random().toString(36).substr(2, 9);

    const updateMasterJson = () => {
        const data = [];
        tbody.find('tr.gallery-row').each(function() {
            const row = $(this),
                imgVal = row.find('.row-image-input').val(),
                capVal = row.find('.row-caption-input').val();

            if (imgVal || capVal) {
                data.push({
                    image: imgVal,
                    caption: capVal
                });
            }
        });

        hiddenInput.val(JSON.stringify(data)).trigger('change');
    };

    const addRow = (imageData, captionData) => {
        const rowId = generateUniqueId(),
            imgValue = imageData || '',
            capValue = captionData || '';

        const html = `<tr class="gallery-row" id="row-${rowId}">
            <td>
                <div class="admin__control-addon" style="display: flex; gap: 5px;">
                    <input type="text" id="input-${rowId}" class="admin__control-text row-image-input" value="${imgValue}" style="flex-grow: 1;" readonly />
                    <button type="button" class="action-default btn-chooser" id="btn-${rowId}" style="padding: 4px 10px;">
                        <?= __('Wybierz') ?>
                    </button>
                </div>
            </td>
            <td>
                <input type="text" class="admin__control-text row-caption-input" value="${capValue}" />
            </td>
            <td style="text-align: center;">
                <button type="button" class="action-delete delete-row-btn" style="color: #e22626; border: none; background: none; font-size: 1.5rem; cursor: pointer; line-height: 1;">&times;</button>
            </td>
        </tr>`;

        tbody.append(html);

        const newRow = $('#row-' + rowId);

        newRow.find('#btn-' + rowId).on('click', function() {
            const targetInputId = 'input-' + rowId,
                url = mediaUrlTemplate.replace('__TARGET_ID__', targetInputId);

            MediabrowserUtility.openDialog(url);
        });

        newRow.find('.row-caption-input, .row-image-input').on('change input', () => {
            updateMasterJson();
        });

        newRow.find('.row-image-input').on('change', () => {
            updateMasterJson();
        });
    };

    if (currentData.length > 0) {
        $.each(currentData, (index, item) => {
            addRow(item.image, item.caption);
        });
    } else {
        addRow();
    }

    $('#add-row-btn-' + elementId).on('click', () => {
        addRow();
        updateMasterJson();
    });

    tbody.on('click', '.delete-row-btn', function() {
        $(this).closest('tr').remove();
        updateMasterJson();
    });
});
</script>

<style>
.rokezzz-gallery-admin-container {
    background: #f8f8f8;
    padding: 15px;
    border: 1px solid #d6d6d6;
    border-radius: 3px;
    margin-top: 5px;
}

.rokezzz-gallery-admin-container table {
    width: 100%;
    margin-bottom: 10px;
}

.rokezzz-gallery-admin-container th {
    padding: 8px;
    background: #ebebeb;
    font-weight: 600;
}

.rokezzz-gallery-admin-container td {
    padding: 8px;
    vertical-align: middle;
}
</style>
