<?php
/** @var \Rokezzz\Core\Block\Slider $block */
$slides = $block->getSlides();
?>
<?php if ($block->isEnabled() && !empty($slides)): ?>
<div class="rokezzz-hero-slider">
    <?php foreach ($slides as $slide): ?>
    <div class="slide-item"
        style="padding: 50px; background-image: url('<?= $block->escapeUrl($slide['image_url'] ?? '') ?>'); background-color: #f4f4f4; border: 2px solid #ddd; margin-bottom: 10px;">
        <div class="slide-content">
            <?php if (!empty($slide['title'])): ?>
            <h2><?= $block->escapeHtml($slide['title']) ?></h2>
            <?php endif; ?>
            <?php if (!empty($slide['description'])): ?>
            <p><?= $block->escapeHtml($slide['description']) ?></p>
            <?php endif; ?>
        </div>
    </div>
    <?php endforeach; ?>
</div>
<?php endif; ?>
