<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <fieldset name="display_settings">
        <field name="is_promoted_on_homepage" sortOrder="10" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">category</item>
                    <item name="default" xsi:type="number">0</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Promuj na stronie głównej</label>
                <dataScope>is_promoted_on_homepage</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap><map name="false" xsi:type="number">0</map><map name="true" xsi:type="number">1</map></valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="show_image_on_homepage" sortOrder="20" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">category</item>
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Pokaż zdjęcie kafelka</label>
                <dataScope>show_image_on_homepage</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap><map name="false" xsi:type="number">0</map><map name="true" xsi:type="number">1</map></valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>
</form>
