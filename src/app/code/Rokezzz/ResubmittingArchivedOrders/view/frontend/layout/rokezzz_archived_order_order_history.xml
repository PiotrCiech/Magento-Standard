<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceContainer name="content">
            <block class="Rokezzz\ResubmittingArchivedOrders\Block\Order\ArchivedHistory"
                   name="rokezzz.archived.order.history"
                   template="Rokezzz_ResubmittingArchivedOrders::order/archived_history.phtml"
                   cacheable="false">
                <arguments>
                    <argument name="archived_order_actions" xsi:type="object">
                        Rokezzz\ResubmittingArchivedOrders\ViewModel\ArchivedOrderActions
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
