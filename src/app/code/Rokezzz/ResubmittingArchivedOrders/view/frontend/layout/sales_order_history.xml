<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="rokezzz.archived.orders.link"
                   template="Rokezzz_ResubmittingArchivedOrders::order/archived_link.phtml"
                   before="sales.order.history">
                <arguments>
                    <argument name="archived_order_actions" xsi:type="object">
                        Rokezzz\ResubmittingArchivedOrders\ViewModel\ArchivedOrderLink
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
