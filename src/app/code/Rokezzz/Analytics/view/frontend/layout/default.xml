<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template"
                   name="rokezzz.google_analytics.gtag"
                   template="Rokezzz_GoogleAnalytics::gtag.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Rokezzz\GoogleAnalytics\ViewModel\Tracking</argument>
                </arguments>
            </block>
            <block class="Magento\Framework\View\Element\Template"
                   name="rokezzz.google_analytics.gtm.head"
                   template="Rokezzz_GoogleAnalytics::gtm-head.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Rokezzz\GoogleAnalytics\ViewModel\Tracking</argument>
                </arguments>
            </block>
        </referenceBlock>
        <referenceContainer name="after.body.start">
            <block class="Magento\Framework\View\Element\Template"
                   name="rokezzz.google_analytics.gtm.body"
                   template="Rokezzz_GoogleAnalytics::gtm-body.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Rokezzz\GoogleAnalytics\ViewModel\Tracking</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
