<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="Rokezzz\Category\Model\Layer\Newest" type="Magento\Catalog\Model\Layer">
        <arguments>
            <argument name="context" xsi:type="object">Rokezzz\Category\Model\Layer\Newest\Context</argument>
        </arguments>
    </virtualType>

    <virtualType name="Rokezzz\Category\Model\Layer\Bestsellers" type="Magento\Catalog\Model\Layer">
        <arguments>
            <argument name="context" xsi:type="object">Rokezzz\Category\Model\Layer\Bestsellers\Context</argument>
        </arguments>
    </virtualType>

    <type name="Magento\Catalog\Model\Layer\Resolver">
        <arguments>
            <argument name="layersPool" xsi:type="array">
                <item name="category" xsi:type="string">Magento\Catalog\Model\Layer\Category</item>
                <item name="search" xsi:type="string">Magento\Catalog\Model\Layer\Search</item>
                <item name="newest" xsi:type="string">Rokezzz\Category\Model\Layer\Newest</item>
                <item name="bestsellers" xsi:type="string">Rokezzz\Category\Model\Layer\Bestsellers</item>
            </argument>
        </arguments>
    </type>

    <virtualType name="Rokezzz\Category\Model\Layer\Newest\StateKey"
                 type="Rokezzz\Category\Model\Layer\StateKey">
        <arguments>
            <argument name="suffix" xsi:type="string">newest</argument>
        </arguments>
    </virtualType>

    <virtualType name="Rokezzz\Category\Model\Layer\Bestsellers\StateKey"
                 type="Rokezzz\Category\Model\Layer\StateKey">
        <arguments>
            <argument name="suffix" xsi:type="string">bestsellers</argument>
        </arguments>
    </virtualType>

    <virtualType name="Rokezzz\Category\Model\Layer\Newest\Context"
                 type="Magento\Catalog\Model\Layer\Context">
        <arguments>
            <argument name="collectionProvider" xsi:type="object">Rokezzz\Category\Model\Layer\ItemCollectionProvider</argument>
            <argument name="stateKey" xsi:type="object">Rokezzz\Category\Model\Layer\Newest\StateKey</argument>
            <argument name="collectionFilter" xsi:type="object">Rokezzz\Category\Model\Layer\Newest\CollectionFilter</argument>
        </arguments>
    </virtualType>

    <virtualType name="Rokezzz\Category\Model\Layer\Bestsellers\Context"
                 type="Magento\Catalog\Model\Layer\Context">
        <arguments>
            <argument name="collectionProvider" xsi:type="object">Rokezzz\Category\Model\Layer\ItemCollectionProvider</argument>
            <argument name="stateKey" xsi:type="object">Rokezzz\Category\Model\Layer\Bestsellers\StateKey</argument>
            <argument name="collectionFilter" xsi:type="object">Rokezzz\Category\Model\Layer\Bestsellers\CollectionFilter</argument>
        </arguments>
    </virtualType>

    <virtualType name="Rokezzz\Category\Model\Layer\FilterList"
                 type="Magento\Catalog\Model\Layer\FilterList">
        <arguments>
            <argument name="filterableAttributes" xsi:type="object">Magento\Catalog\Model\Layer\Category\FilterableAttributeList</argument>
            <argument name="filters" xsi:type="array">
                <item name="attribute" xsi:type="string">Magento\Catalog\Model\Layer\Filter\Attribute</item>
                <item name="price" xsi:type="string">Magento\Catalog\Model\Layer\Filter\Price</item>
                <item name="decimal" xsi:type="string">Magento\Catalog\Model\Layer\Filter\Decimal</item>
                <item name="category" xsi:type="string">Magento\Catalog\Model\Layer\Filter\Category</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="Rokezzz\Category\Block\Navigation"
                 type="Magento\LayeredNavigation\Block\Navigation">
        <arguments>
            <argument name="filterList" xsi:type="object">Rokezzz\Category\Model\Layer\FilterList</argument>
        </arguments>
    </virtualType>

    <type name="Magento\Catalog\Model\Layer\Category\CollectionFilter">
        <plugin name="rokezzz_category_news_attributes"
                type="Rokezzz\Category\Plugin\Catalog\Model\Layer\AddNewsAttributesToCollectionPlugin"/>
    </type>

    <type name="Magento\Catalog\Model\Layer\Search\CollectionFilter">
        <plugin name="rokezzz_category_news_attributes_search"
                type="Rokezzz\Category\Plugin\Catalog\Model\Layer\AddNewsAttributesToCollectionPlugin"/>
    </type>

    <type name="Rokezzz\Category\Block\Product\Bestsellers">
        <arguments>
            <argument name="context" xsi:type="object">Magento\Catalog\Block\Product\Context</argument>
        </arguments>
    </type>
</config>
