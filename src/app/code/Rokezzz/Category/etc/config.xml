<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <rokezzz_category>
            <general>
                <enable_new>1</enable_new>
                <enable_bestsellers>1</enable_bestsellers>
            </general>
            <product_labels>
                <enable_bestseller_badge>1</enable_bestseller_badge>
                <enable_discount_badge>0</enable_discount_badge>
                <enable_low_stock_badge>1</enable_low_stock_badge>
                <low_stock_threshold>5</low_stock_threshold>
            </product_labels>
        </rokezzz_category>
    </default>
</config>
