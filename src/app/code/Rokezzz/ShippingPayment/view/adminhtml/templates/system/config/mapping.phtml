<?php
/**
 * @var \Rokezzz\ShippingPayment\Block\Adminhtml\System\Config\Form\Field\Mapping $block
 */

$carrierOptions = $block->getCarrierOptions();
$paymentOptions = $block->getPaymentOptions();
?>
<div class="rokezzz-shipping-payment-mapping">
    <input type="hidden"
           name="<?= $block->escapeHtmlAttr($block->getEmptyInputName()) ?>"
           value=""/>

    <?php if ($carrierOptions === []): ?>
        <p><?= $block->escapeHtml(__('No shipping carriers are available.')) ?></p>
    <?php elseif ($paymentOptions === []): ?>
        <p><?= $block->escapeHtml(__('No payment methods are available.')) ?></p>
    <?php else: ?>
        <?php foreach ($carrierOptions as $carrierOption): ?>
            <?php
            $carrierCode = $carrierOption['value'];
            $fieldId = $block->getFieldId($carrierCode);
            $selected = $block->getSelectedPaymentCodes($carrierCode);
            ?>
            <div class="rokezzz-shipping-payment-mapping__row">
                <label for="<?= $block->escapeHtmlAttr($fieldId) ?>"
                       class="rokezzz-shipping-payment-mapping__label">
                    <?= $block->escapeHtml($carrierOption['label']) ?>
                </label>
                <select id="<?= $block->escapeHtmlAttr($fieldId) ?>"
                        name="<?= $block->escapeHtmlAttr($block->getFieldName($carrierCode)) ?>[]"
                        class="select multiselect admin__control-multiselect rokezzz-shipping-payment-mapping__select"
                        multiple="multiple"
                        size="6">
                    <?php foreach ($paymentOptions as $paymentOption): ?>
                        <option value="<?= $block->escapeHtmlAttr($paymentOption['value']) ?>"
                            <?= in_array($paymentOption['value'], $selected, true) ? 'selected="selected"' : '' ?>>
                            <?= $block->escapeHtml($paymentOption['label']) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>
        <?php endforeach; ?>
    <?php endif; ?>
</div>
