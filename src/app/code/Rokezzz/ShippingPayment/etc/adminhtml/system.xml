<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="rokezzz_shipping_payment" translate="label" sortOrder="975"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Rokezzz Shipping Payment</label>
            <tab>general</tab>
            <resource>Rokezzz_ShippingPayment::config</resource>
            <group id="general" translate="label" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable</label>
                    <comment>When enabled, payment methods are limited by the selected shipping carrier.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="payment_methods" translate="label comment" sortOrder="20"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Payment Methods per Shipping Carrier</label>
                <comment><![CDATA[For each shipping carrier (e.g. InPost Kurier, Flat Rate), select which payment methods are allowed. All methods of that carrier share the same payment rules. Leave a carrier empty to allow all payment methods for it. Lists are built dynamically from active Magento carriers and payment methods.]]></comment>
                <field id="mapping" translate="label" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Mapping</label>
                    <frontend_model>Rokezzz\ShippingPayment\Block\Adminhtml\System\Config\Form\Field\Mapping</frontend_model>
                    <backend_model>Rokezzz\ShippingPayment\Model\Config\Backend\Mapping</backend_model>
                    <depends>
                        <field id="general/enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
