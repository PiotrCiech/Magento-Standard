<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Rokezzz\Blog\Block\Widget\LatestPosts;

/** @var LatestPosts $block */
/** @var Escaper $escaper */
?>
<?php if ($block->shouldRender()): ?>
<div class="block rokezzz-blog-latest-posts">
    <?php if ($block->getTitle() !== ''): ?>
    <div class="block-title">
        <strong><?= $escaper->escapeHtml($block->getTitle()) ?></strong>
    </div>
    <?php endif; ?>

    <div class="block-content">
        <div class="blog-post-grid">
            <?php foreach ($block->getPosts() as $post): ?>
            <?php $bgImage = $block->getImageUrl($post->getBackgroundImage()); ?>
            <article class="blog-post-card">
                <?php if ($bgImage): ?>
                <div class="blog-post-image">
                    <a href="<?= $escaper->escapeUrl($block->getUrl('blog/' . $post->getIdentifier())) ?>">
                        <img src="<?= $escaper->escapeUrl($bgImage) ?>"
                            alt="<?= $escaper->escapeHtmlAttr($post->getTitle()) ?>" loading="lazy" />
                    </a>
                </div>
                <?php endif; ?>

                <div class="blog-post-content">
                    <span class="blog-meta-date">
                        <?= $escaper->escapeHtml(date('d.m.Y', strtotime((string)$post->getPublishedAt()))) ?>
                    </span>

                    <h3 class="blog-post-title">
                        <a href="<?= $escaper->escapeUrl($block->getUrl('blog/' . $post->getIdentifier())) ?>">
                            <?= $escaper->escapeHtml($post->getTitle()) ?>
                        </a>
                    </h3>

                    <?php if ($post->getShortContent()): ?>
                    <div class="blog-post-excerpt">
                        <?= $escaper->escapeHtml($post->getShortContent()) ?>
                    </div>
                    <?php endif; ?>
                </div>
            </article>
            <?php endforeach; ?>
        </div>

        <div class="blog-post-grid-more">
            <a href="<?= $escaper->escapeUrl($block->getUrl('blog')) ?>">
                <?= $escaper->escapeHtml(__('See all posts')) ?>
            </a>
        </div>
    </div>
</div>
<?php endif; ?>
