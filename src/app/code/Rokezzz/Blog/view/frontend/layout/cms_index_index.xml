<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Rokezzz\Blog\Block\Widget\LatestPosts"
                   name="rokezzz.homepage.blog.latest"
                   template="Rokezzz_Blog::widget/latest-posts.phtml"
                   ifconfig="rokezzz_blog/general/enable_latest_posts"
                   after="rokezzz.homepage.about">
                <arguments>
                    <argument name="title" xsi:type="string" translate="true">Latest from the blog</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
