<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">rokezzz_blog_author_form.rokezzz_blog_author_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Author Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Rokezzz\Blog\Block\Adminhtml\Author\Edit\BackButton"/>
            <button name="save" class="Rokezzz\Blog\Block\Adminhtml\Author\Edit\SaveButton"/>
            <button name="delete" class="Rokezzz\Blog\Block\Adminhtml\Author\Edit\DeleteButton"/>
        </buttons>
        <namespace>rokezzz_blog_author_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>rokezzz_blog_author_form.rokezzz_blog_author_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="rokezzz_blog_author_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="rokezzz_blog/author/save"/>
        </settings>
        <dataProvider class="Rokezzz\Blog\Model\Author\DataProvider" name="rokezzz_blog_author_form_data_source">
            <settings>
                <requestFieldName>author_id</requestFieldName>
                <primaryFieldName>author_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="10">
        <settings>
            <collapsible>false</collapsible>
            <label translate="true">General</label>
        </settings>
        <field name="author_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>
        <field name="firstname" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">First Name</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="lastname" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Last Name</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="job_title" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Job Title</label>
            </settings>
        </field>
        <field name="avatar" formElement="imageUploader" sortOrder="40">
            <settings>
                <label translate="true">Avatar</label>
                <componentType>imageUploader</componentType>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <allowedExtensions>jpg jpeg gif png webp</allowedExtensions>
                        <maxFileSize>4194304</maxFileSize>
                        <uploaderConfig>
                            <param xsi:type="string" name="url">rokezzz_blog/author_image/upload</param>
                        </uploaderConfig>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
    </fieldset>
</form>
