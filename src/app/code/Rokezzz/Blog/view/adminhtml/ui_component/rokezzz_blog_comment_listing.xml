<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">rokezzz_blog_comment_listing.rokezzz_blog_comment_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>rokezzz_blog_comment_columns</spinner>
        <deps>
            <dep>rokezzz_blog_comment_listing.rokezzz_blog_comment_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="rokezzz_blog_comment_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
            <storageConfig>
                <param name="indexField" xsi:type="string">comment_id</param>
            </storageConfig>
        </settings>
        <aclResource>Rokezzz_Blog::comments</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="rokezzz_blog_comment_listing_data_source">
            <settings>
                <requestFieldName>comment_id</requestFieldName>
                <primaryFieldName>comment_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <massaction name="listing_massaction" component="Magento_Ui/js/grid/tree-massactions">
            <action name="approve">
                <settings>
                    <url path="rokezzz_blog/comment/massApprove"/>
                    <type>approve</type>
                    <label translate="true">Accept</label>
                </settings>
            </action>
            <action name="reject">
                <settings>
                    <url path="rokezzz_blog/comment/massReject"/>
                    <type>reject</type>
                    <label translate="true">Reject</label>
                </settings>
            </action>
        </massaction>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="rokezzz_blog_comment_columns">
        <selectionsColumn name="ids" sortOrder="0">
            <settings>
                <indexField>comment_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="comment_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="post_title" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Post</label>
            </settings>
        </column>
        <column name="author_name" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Author Name</label>
            </settings>
        </column>
        <column name="author_email" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Author Email</label>
            </settings>
        </column>
        <column name="content" sortOrder="50">
            <settings>
                <filter>text</filter>
                <label translate="true">Content</label>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select" sortOrder="60">
            <settings>
                <options class="Rokezzz\Blog\Model\Comment\Source\Status"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="70">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created At</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Rokezzz\Blog\Ui\Component\Listing\Column\CommentActions" sortOrder="100">
            <settings>
                <indexField>comment_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
