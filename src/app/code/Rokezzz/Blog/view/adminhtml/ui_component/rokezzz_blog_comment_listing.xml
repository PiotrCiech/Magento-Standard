<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">rokezzz_blog_comment_listing.rokezzz_blog_comment_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>rokezzz_blog_comment_columns</spinner>
        <deps>
            <dep>rokezzz_blog_comment_listing.rokezzz_blog_comment_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="rokezzz_blog_comment_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">comment_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Rokezzz_Blog::comments</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="rokezzz_blog_comment_listing_data_source">
            <settings>
                <requestFieldName>comment_id</requestFieldName>
                <primaryFieldName>comment_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="approve">
                <settings>
                    <url path="rokezzz_blog/comment/massApprove"/>
                    <type>approve</type>
                    <label translate="true">Approve</label>
                </settings>
            </action>
            <action name="not_approve">
                <settings>
                    <url path="rokezzz_blog/comment/massNotApprove"/>
                    <type>not_approve</type>
                    <label translate="true">Not Approved</label>
                </settings>
            </action>
            <action name="delete">
                <settings>
                    <url path="rokezzz_blog/comment/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                    <confirm>
                        <title translate="true">Delete Comments</title>
                        <message translate="true">Are you sure you want to delete the selected comments?</message>
                    </confirm>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="rokezzz_blog_comment_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>comment_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="comment_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="post_title" sortOrder="15">
            <settings>
                <filter>text</filter>
                <label translate="true">Post</label>
            </settings>
        </column>
        <column name="nickname" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>
        <column name="email" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Email</label>
            </settings>
        </column>
        <column name="detail" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Comment</label>
            </settings>
        </column>
        <column name="status_id" class="Rokezzz\Blog\Ui\Component\Listing\Column\CommentStatus" sortOrder="50">
            <settings>
                <options class="Rokezzz\Blog\Model\Comment\Source\Status"/>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="60">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created At</label>
            </settings>
        </column>
    </columns>
</listing>
