<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Rokezzz_Core::main">
                    <resource id="Rokezzz_Core::content">
                        <resource id="Rokezzz_Blog::blog" title="Blog" sortOrder="80">
                            <resource id="Rokezzz_Blog::categories" title="Categories" sortOrder="10"/>
                            <resource id="Rokezzz_Blog::posts" title="Posts" sortOrder="20"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
