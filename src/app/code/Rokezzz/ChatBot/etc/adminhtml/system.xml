<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="rokezzz_chat_bot" translate="label" sortOrder="945" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Rokezzz ChatBot (tawk.to)</label>
            <tab>general</tab>
            <resource>Magento_Config::config</resource>
            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Widget</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="property_id" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Property ID</label>
                    <comment>Available in tawk.to dashboard: Administration &gt; Channels &gt; Chat Widget. The widget is injected only when this field is filled.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="widget_id" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Widget ID</label>
                    <comment>Available next to the Property ID in the tawk.to dashboard. Leave empty to use "default".</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="behavior" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Widget Behavior</label>
                <field id="auto_start" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Auto start connection</label>
                    <comment>Tawk_API.autoStart. When disabled, the widget stays hidden on page load until started via the JavaScript API.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="hide_on_load" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Hide widget on page load</label>
                    <comment>Calls Tawk_API.hideWidget() in onBeforeLoad. The chat connects in the background but the bubble stays invisible until shown via the JavaScript API.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="z_index" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Widget z-index</label>
                    <comment>Tawk_API.customStyle.zIndex. Leave empty to use the tawk.to default.</comment>
                    <frontend_class>validate-digits</frontend_class>
                </field>
            </group>
        </section>
    </system>
</config>
