<?php

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Rokezzz\ChatBot\ViewModel\Widget;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var Widget $viewModel */
$viewModel = $block->getViewModel();

if (!$viewModel->isActive()) {
    return;
}

$zIndex = $viewModel->getZIndex();
?>
<!--Start of Tawk.to Script-->
<script>
    window.Tawk_API = window.Tawk_API || {};
    window.Tawk_LoadStart = new Date();
<?php if (!$viewModel->isAutoStart()): ?>
    window.Tawk_API.autoStart = false;
<?php endif; ?>
<?php if (!is_null($zIndex)): ?>
    window.Tawk_API.customStyle = { zIndex: <?= (int) $zIndex ?> };
<?php endif; ?>
<?php if ($viewModel->isHiddenOnLoad()): ?>
    window.Tawk_API.onBeforeLoad = function () {
        window.Tawk_API.hideWidget();
    };
<?php endif; ?>
    (function () {
        var s1 = document.createElement('script');
        var s0 = document.getElementsByTagName('script')[0];
        s1.async = true;
        s1.src = '<?= $escaper->escapeJs($viewModel->getWidgetSrc()) ?>';
        s1.charset = 'UTF-8';
        s1.setAttribute('crossorigin', '*');
        s0.parentNode.insertBefore(s1, s0);
    })();
</script>
<!--End of Tawk.to Script-->
