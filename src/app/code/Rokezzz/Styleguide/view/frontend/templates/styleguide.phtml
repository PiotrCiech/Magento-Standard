<script>
require(['jquery'], function ($) {
    'use strict';

    var $acc = $('#sg-accordion');
    $acc.on('click', '.accordion-header', function () {
        var $item = $(this).closest('.accordion-item'),
            $content = $item.find('.accordion-content');
        if ($item.hasClass('active')) {
            $content.slideUp(200);
            $item.removeClass('active');
        } else {
            $acc.find('.accordion-item.active').removeClass('active')
                .find('.accordion-content').slideUp(200);
            $content.slideDown(200);
            $item.addClass('active');
        }
    });

    (function () {
        var $g = $('#sg-gallery-demo'),
            $slides = $g.find('.gallery-slide'),
            $thumbs = $g.find('.thumb-item'),
            idx = 0;
        function show(i) {
            idx = (i + $slides.length) % $slides.length;
            $slides.removeClass('active').eq(idx).addClass('active');
            $thumbs.removeClass('active').eq(idx).addClass('active');
        }
        $g.find('.next-btn').on('click', function () { show(idx + 1); });
        $g.find('.prev-btn').on('click', function () { show(idx - 1); });
        $thumbs.on('click', function () { show($(this).data('slide-index')); });
    })();

    (function () {
        var $s = $('#sg-slider-demo'),
            $wrap = $s.find('.slider-wrapper'),
            $dots = $s.find('.dot'),
            count = $s.find('.slide').length,
            cur = 0, timer;
        function go(i) {
            cur = (i + count) % count;
            $wrap.css('transform', 'translateX(' + (-100 * cur) + '%)');
            $dots.removeClass('active').eq(cur).addClass('active');
        }
        function play() { timer = setInterval(function () { go(cur + 1); }, 4000); }
        $dots.on('click', function () { clearInterval(timer); go($(this).data('slide-index')); play(); });
        play();
    })();
});
</script>
