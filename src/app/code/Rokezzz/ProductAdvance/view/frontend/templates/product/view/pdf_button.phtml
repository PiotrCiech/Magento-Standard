<?php
declare(strict_types=1);

use Magento\Catalog\Block\Product\View;

/** @var View $block */
$_product = $block->getProduct();
$_pdfUrl = $block->getUrl('productadvance/pdf/download', ['id' => $_product->getId()]);
?>

<div class="product-pdf-download-wrapper">
    <a href="<?= $block->escapeUrl($_pdfUrl) ?>" class="action download-pdf-btn">
        <span><?= $block->escapeHtml(__('Pobierz specyfikację PDF')) ?></span>
    </a>
</div>

<script>
require(['jquery'], function(jQuery) {
    'use strict';

    jQuery('.download-pdf-btn').on('click', function(e) {
        e.preventDefault();
        const url = jQuery(this).attr('href'),
            iframeId = 'hidden-print-iframe';

        jQuery('#' + iframeId).remove();
        const iframe = jQuery('<iframe>', {
            id: iframeId,
            src: url,
            style: 'visibility: hidden; position: absolute; width: 0; height: 0; border: none;'
        });

        jQuery('body').append(iframe);
        iframe.on('load', function() {
            this.contentWindow.focus();
            this.contentWindow.print();
        });
    });
});
</script>
