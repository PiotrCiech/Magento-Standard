<?php
declare(strict_types=1);

use Magento\Catalog\Block\Product\View;

/** @var View $block */
$_product = $block->getProduct();
$_sku = $_product->getSku();
?>

<div class="copy-sku-wrapper">
    <button type="button" class="action copy-sku-btn" data-sku="<?= $block->escapeHtmlAttr($_sku) ?>"
        title="<?= $block->escapeHtmlAttr(__('Kopiuj SKU')) ?>">
        <span class="btn-text"><?= $block->escapeHtml(__('Kopiuj kod')) ?></span>
    </button>
</div>

<script>
    require(['jquery'], function (jQuery) {
        'use strict';

        jQuery('.copy-sku-btn').on('click', function () {
            const btn = jQuery(this),
                btnText = btn.find('.btn-text'),
                originalText = btnText.text(),
                sku = btn.data('sku');

            navigator.clipboard.writeText(sku).then(function () {
                btnText.text('Skopiowano!');
                btn.addClass('copied');

                setTimeout(function () {
                    btnText.text(originalText);
                    btn.removeClass('copied');
                }, 1500);
            });
        });
    });
</script>