<?php
/** @var \Rokezzz\Orders\Block\Order\Comment $block */
/** @var \Rokezzz\Orders\ViewModel\Order\Comment $viewModel */
$viewModel = $block->getData('view_model');
$order = $block->getOrder();
?>
<?php if (!is_null($order) && $viewModel->shouldDisplay($order)) : ?>
    <section class="admin__page-section order-view-comment">
        <div class="admin__page-section-title">
            <span class="title"><?= $block->escapeHtml(__('Customer checkout notes')) ?></span>
        </div>
        <div class="admin__page-section-content">
            <div class="admin__page-section-item order-comment">
                <div class="admin__page-section-item-content">
                    <p><?= $block->escapeHtml($viewModel->getCustomerNote($order), ['br']) ?></p>
                </div>
            </div>
        </div>
    </section>
<?php endif; ?>
