<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>{{ category_name }}</title>
    <style>{{ styles|raw }}</style>
</head>
<body>
    <h1>{{ category_name }}</h1>

    {% if items is empty %}
        <p class="empty">{{ empty_message }}</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Product</th>
                    <th>Price</th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>{{ item.sku }}</td>
                        <td>{{ item.name }}</td>
                        <td>{{ item.price }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if platform_signature %}
        <div class="platform-signature">
            {{ platform_signature }}
        </div>
    {% endif %}
</body>
</html>
