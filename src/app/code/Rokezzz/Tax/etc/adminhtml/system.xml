<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="tax">
            <group id="rokezzz_display" translate="label" sortOrder="35" showInDefault="1" showInWebsite="1"
                   showInStore="1">
                <label>Rokezzz Price Display</label>
                <field id="mode" translate="label comment" type="select" sortOrder="10" showInDefault="1"
                       showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Display Prices</label>
                    <comment>Sets catalog, cart and order prices to including tax (gross) or excluding tax (net). Catalog Search index is invalidated automatically after change.</comment>
                    <source_model>Rokezzz\Tax\Model\Config\Source\PriceDisplayMode</source_model>
                    <backend_model>Rokezzz\Tax\Model\Config\Backend\PriceDisplayMode</backend_model>
                </field>
            </group>
        </section>
    </system>
</config>
