<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="product.info.price">
            <block class="Magento\Framework\View\Element\Template"
                   name="product.info.omnibus"
                   template="Rokezzz_Omnibus::omnibus-price.phtml"
                   after="product.price.final">
                <arguments>
                    <argument name="view_model" xsi:type="object">Rokezzz\Omnibus\ViewModel\OmnibusPrice</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
