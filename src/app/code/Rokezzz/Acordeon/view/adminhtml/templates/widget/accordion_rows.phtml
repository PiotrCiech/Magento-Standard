<?php
declare(strict_types=1);

use Rokezzz\Acordeon\Block\Adminhtml\Widget\AccordionRows;

/** @var AccordionRows $block */

$element = $block->getElement();
$elementId = $element->getHtmlId();
$value = $element->getValue();
?>

<div class="rokezzz-accordion-admin-container" id="accordion-container-<?= $elementId ?>">
    <input type="hidden" id="<?= $elementId ?>" name="<?= $element->getName() ?>"
        value="<?= $block->escapeHtmlAttr($value) ?>" class="widget-option" />

    <table class="admin__control-table">
        <thead>
            <tr>
                <th style="width: 40%;"><?= __('Pytanie') ?></th>
                <th style="width: 50%;"><?= __('Odpowiedź (HTML dozwolony)') ?></th>
                <th style="width: 10%; text-align: center;"><?= __('Akcja') ?></th>
            </tr>
        </thead>
        <tbody id="accordion-rows-tbody-<?= $elementId ?>">
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="col-actions">
                    <button type="button" class="action-add" id="add-row-btn-<?= $elementId ?>">
                        <span><?= __('Dodaj element akordeonu') ?></span>
                    </button>
                </td>
            </tr>
        </tfoot>
    </table>
</div>

<script>
require(['jquery'], function($) {
    const elementId = '<?= $elementId ?>',
        hiddenInput = $('#' + elementId),
        tbody = $('#accordion-rows-tbody-' + elementId);

    $('#accordion-container-' + elementId)
        .closest('.admin__field-control')
        .find('.control-value')
        .hide();

    let currentData = [];

    try {
        const rawValue = hiddenInput.val();

        if (rawValue) {
            currentData = JSON.parse(rawValue);
        }
    } catch (e) {
        console.error(e);
    }

    const generateUniqueId = () => 'acc_' + Math.random().toString(36).substr(2, 9);

    const updateMasterJson = () => {
        const data = [];

        tbody.find('tr.accordion-row').each(function() {
            const row = $(this),
                titleVal = row.find('.row-title-input').val(),
                contentVal = row.find('.row-content-input').val();

            if (titleVal || contentVal) {
                data.push({
                    title: titleVal,
                    content: contentVal
                });
            }
        });

        hiddenInput.val(JSON.stringify(data)).trigger('change');
    };

    const addRow = (titleData, contentData) => {
        const rowId = generateUniqueId(),
            titleValue = titleData || '',
            contentValue = contentData || '';

        const html = `<tr class="accordion-row" id="row-${rowId}">
            <td>
                <input type="text" class="admin__control-text row-title-input" value="${titleValue}" />
            </td>
            <td>
                <textarea class="admin__control-textarea row-content-input" style="width: 100%; height: 60px; resize: vertical;">${contentValue}</textarea>
            </td>
            <td style="text-align: center;">
                <button type="button" class="action-delete delete-row-btn" style="color: #e22626; border: none; background: none; font-size: 1.5rem; cursor: pointer; line-height: 1;">&times;</button>
            </td>
        </tr>`;

        tbody.append(html);

        const newRow = $('#row-' + rowId);

        newRow.find('.row-title-input, .row-content-input').on('change input', () => {
            updateMasterJson();
        });
    };

    if (currentData.length > 0) {
        $.each(currentData, (index, item) => {
            addRow(item.title, item.content);
        });
    } else {
        addRow();
    }

    $('#add-row-btn-' + elementId).on('click', () => {
        addRow();
        updateMasterJson();
    });

    tbody.on('click', '.delete-row-btn', function() {
        $(this).closest('tr').remove();
        updateMasterJson();
    });
});
</script>

<style>
.rokezzz-accordion-admin-container {
    background: #ffffff;
    padding: 15px;
    border: 1px solid #d6d6d6;
    border-radius: 3px;
    margin-top: 5px;
}

.rokezzz-accordion-admin-container table {
    width: 100%;
    margin-bottom: 10px;
}

.rokezzz-accordion-admin-container th {
    padding: 8px;
    background: #ebebeb;
    font-weight: 600;
}

.rokezzz-accordion-admin-container td {
    padding: 8px;
    vertical-align: middle;
}
</style>
