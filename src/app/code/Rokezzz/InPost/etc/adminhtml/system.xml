<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="rokezzz_inpost" translate="label" sortOrder="950" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Rokezzz InPost</label>
            <tab>general</tab>
            <resource>Rokezzz_InPost::config</resource>
            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>InPost Paczkomaty</label>
                <field id="module_status" translate="label" sortOrder="5" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Official module status</label>
                    <frontend_model>Rokezzz\InPost\Block\Adminhtml\System\Config\Form\Field\ModuleStatus</frontend_model>
                </field>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable InPost integration</label>
                    <comment>When disabled, InPost Paczkomaty and courier shipping rates are hidden on the storefront. Configure API credentials in Stores → Configuration → Sales → Shipping Settings → InPost.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
