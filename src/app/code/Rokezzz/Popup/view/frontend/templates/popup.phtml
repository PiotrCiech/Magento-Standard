<?php
/** @var \Rokezzz\Popup\Block\Popup $block */
if (!$block->isEnabled() || !$block->getCmsBlockId()) {
    return;
}
?>

<div id="rokezzz-promo-modal" style="display:none;">
    <?= $block->getLayout()
        ->createBlock(\Magento\Cms\Block\Block::class)
        ->setBlockId($block->getCmsBlockId())
        ->toHtml(); ?>
</div>

<script>
require([
    'jquery',
    'Magento_Ui/js/modal/modal'
], function($, modal) {
    'use strict';

    var popupKey = 'rokezzz_popup_shown';
    var popup = $('#rokezzz-promo-modal');

    if (localStorage.getItem(popupKey)) {
        return;
    }

    var options = {
        type: 'popup',
        responsive: true,
        innerScroll: true,
        title: '',
        buttons: [],
        keyEventHandlers: {
            escapeKey: function(e) {
                var modalEl = popup.closest('.modal-popup');
                if (modalEl.hasClass('_show') && !modalEl.hasClass('closing')) {
                    e.preventDefault();
                    e.stopPropagation();
                    triggerPopupClose(modalEl);
                }
            }
        },
        opened: function() {
            var modalEl = popup.closest('.modal-popup');
            modalEl.off('click.modal');
            modalEl.on('click.rokezzzPopup', function(e) {
                if ($(e.target).hasClass('modal-popup') || $(e.target).closest('.action-close')
                    .length) {
                    e.preventDefault();
                    triggerPopupClose(modalEl);
                }
            });
        },
        closed: function() {
            localStorage.setItem(popupKey, 'true');
        }
    };

    function triggerPopupClose(modalEl) {
        if (modalEl.hasClass('closing')) {
            return;
        }

        modalEl.addClass('closing');
        setTimeout(function() {
            popup.modal('closeModal');
            modalEl.removeClass('closing');
        }, 350);
    }

    modal(options, popup);

    var delayTime = <?= $block->getDelayTime() ?>;

    setTimeout(function() {
        popup.modal('openModal');
    }, delayTime);
});
</script>