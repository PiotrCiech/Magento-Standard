<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">rokezzz_offers_offer_form.rokezzz_offers_offer_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Offer</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Rokezzz\Offers\Block\Adminhtml\Offer\Edit\BackButton"/>
            <button name="save" class="Rokezzz\Offers\Block\Adminhtml\Offer\Edit\SaveButton"/>
            <button name="send" class="Rokezzz\Offers\Block\Adminhtml\Offer\Edit\SendButton"/>
            <button name="reject" class="Rokezzz\Offers\Block\Adminhtml\Offer\Edit\RejectButton"/>
        </buttons>
        <namespace>rokezzz_offers_offer_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>rokezzz_offers_offer_form.rokezzz_offers_offer_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="rokezzz_offers_offer_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="rokezzz_offers/offer/save"/>
        </settings>
        <dataProvider class="Rokezzz\Offers\Model\Offer\DataProvider" name="rokezzz_offers_offer_form_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="10">
        <settings>
            <collapsible>false</collapsible>
            <label translate="true">General</label>
        </settings>
        <field name="entity_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>
        <field name="request_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>
        <field name="increment_id" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Offer Number</label>
                <disabled>true</disabled>
                <visible>false</visible>
            </settings>
        </field>
        <field name="status" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Status</label>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="customer_id" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Customer ID</label>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="customer_note" formElement="textarea" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Customer Note</label>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="admin_note" formElement="textarea" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Admin Note</label>
            </settings>
        </field>
        <field name="expires_at" formElement="date" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Valid Until (optional)</label>
                <notice translate="true">Leave empty if the offer should remain available indefinitely.</notice>
            </settings>
        </field>
    </fieldset>
    <dynamicRows name="items" component="Magento_Ui/js/dynamic-rows/dynamic-rows" sortOrder="20">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="addButton" xsi:type="boolean">false</item>
                    <item name="deleteButton" xsi:type="boolean">false</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Items</label>
                <componentType>dynamicRows</componentType>
            </settings>
            <container name="record" component="Magento_Ui/js/dynamic-rows/record">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="isTemplate" xsi:type="boolean">true</item>
                        <item name="is_collection" xsi:type="boolean">true</item>
                        <item name="componentType" xsi:type="string">container</item>
                    </item>
                </argument>
                <field name="request_item_id" formElement="input" sortOrder="10">
                    <settings>
                        <dataType>text</dataType>
                        <visible>false</visible>
                    </settings>
                </field>
                <field name="product_id" formElement="input" sortOrder="20">
                    <settings>
                        <dataType>text</dataType>
                        <visible>false</visible>
                    </settings>
                </field>
                <field name="sku" formElement="input" sortOrder="30">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">SKU</label>
                        <disabled>true</disabled>
                    </settings>
                </field>
                <field name="name" formElement="input" sortOrder="40">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Product Name</label>
                        <disabled>true</disabled>
                    </settings>
                </field>
                <field name="requested_qty" formElement="input" sortOrder="50">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Requested Qty</label>
                        <disabled>true</disabled>
                    </settings>
                </field>
                <field name="offered_qty" formElement="input" sortOrder="60">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Offered Qty</label>
                        <validation>
                            <rule name="required-entry" xsi:type="boolean">true</rule>
                            <rule name="validate-number" xsi:type="boolean">true</rule>
                        </validation>
                    </settings>
                </field>
                <field name="offered_price" formElement="input" sortOrder="70">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Offered Price</label>
                        <validation>
                            <rule name="required-entry" xsi:type="boolean">true</rule>
                            <rule name="validate-number" xsi:type="boolean">true</rule>
                        </validation>
                    </settings>
                </field>
            </container>
        </dynamicRows>
</form>
