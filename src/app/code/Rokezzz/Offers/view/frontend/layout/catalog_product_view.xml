<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="product.info.main">
            <block class="Magento\Framework\View\Element\Template"
                   name="rokezzz.offers.product.quote.request"
                   template="Rokezzz_Offers::catalog/product/quote_request.phtml"
                   after="product.info.addtocart">
                <arguments>
                    <argument name="view_model" xsi:type="object">Rokezzz\Offers\ViewModel\Catalog\ProductQuoteRequest</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
