<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="2columns-left"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceBlock name="customer_account_navigation">
            <block class="Magento\Framework\View\Element\Html\Link\Current"
                   name="customer-account-navigation-rokezzz-offers">
                <arguments>
                    <argument name="path" xsi:type="string">rokezzz_offers/offer/index</argument>
                    <argument name="label" xsi:type="string" translate="true">My Offers</argument>
                </arguments>
            </block>
            <block class="Magento\Framework\View\Element\Html\Link\Current"
                   name="customer-account-navigation-rokezzz-offer-requests">
                <arguments>
                    <argument name="path" xsi:type="string">rokezzz_offers/request/history</argument>
                    <argument name="label" xsi:type="string" translate="true">Quote Requests</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
