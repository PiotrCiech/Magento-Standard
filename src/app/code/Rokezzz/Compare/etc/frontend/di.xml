<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Catalog\ViewModel\Product\Checker\AddToCompareAvailability">
        <plugin name="rokezzz_compare_restrict_add_to_compare"
                type="Rokezzz\Compare\Plugin\Catalog\ViewModel\Product\Checker\RestrictAddToCompareAvailabilityPlugin"/>
    </type>
    <type name="Magento\Catalog\Block\Product\ProductList\Item\AddTo\Compare">
        <plugin name="rokezzz_compare_hide_list_compare_link"
                type="Rokezzz\Compare\Plugin\Catalog\Block\Product\ProductList\Item\AddTo\HideListCompareLinkPlugin"/>
    </type>
    <type name="Magento\Catalog\CustomerData\CompareProducts">
        <plugin name="rokezzz_compare_empty_customer_section"
                type="Rokezzz\Compare\Plugin\Catalog\CustomerData\EmptyCompareSectionWhenDisabledPlugin"/>
    </type>
    <type name="Magento\Framework\View\Element\Template">
        <plugin name="rokezzz_compare_hide_sidebar_blocks"
                type="Rokezzz\Compare\Plugin\Framework\View\Element\HideCompareSidebarBlocksPlugin"/>
    </type>
    <type name="Magento\Catalog\Controller\Product\Compare">
        <plugin name="rokezzz_compare_block_actions"
                type="Rokezzz\Compare\Plugin\Catalog\Controller\Product\Compare\BlockCompareActionsWhenDisabledPlugin"/>
    </type>
</config>
