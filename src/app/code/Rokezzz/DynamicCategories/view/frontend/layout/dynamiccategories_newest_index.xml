<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd"
      layout="1column">
    <body>
        <referenceContainer name="content">
            <block class="Rokezzz\DynamicCategories\Block\Product\Newest"
                   name="dynamiccategories.newest.list"
                   template="Magento_Catalog::product/list.phtml">
                <arguments>
                    <argument name="page_title" xsi:type="string">New Arrivals</argument>
                    <argument name="viewModel" xsi:type="object">Magento\Catalog\ViewModel\Product\OptionsData</argument>
                </arguments>
                <container name="dynamiccategories.newest.product.list.additional" as="additional"/>
                <block class="Magento\Framework\View\Element\RendererList"
                       name="dynamiccategories.newest.product.type.details.renderers"
                       as="details.renderers">
                    <block class="Magento\Framework\View\Element\Template"
                           name="dynamiccategories.newest.product.type.details.renderers.default"
                           as="default"/>
                </block>
                <block class="Magento\Catalog\Block\Product\ProductList\Item\Container"
                       name="dynamiccategories.newest.product.addto"
                       as="addto">
                    <block class="Magento\Catalog\Block\Product\ProductList\Item\AddTo\Compare"
                           name="dynamiccategories.newest.product.addto.compare"
                           as="compare"
                           template="Magento_Catalog::product/list/addto/compare.phtml"/>
                </block>
                <block class="Magento\Catalog\Block\Product\ProductList\Toolbar"
                       name="dynamiccategories.newest.product.list.toolbar"
                       as="toolbar"
                       template="Magento_Catalog::product/list/toolbar.phtml">
                    <block class="Magento\Theme\Block\Html\Pager"
                           name="dynamiccategories.newest.product.list.toolbar.pager"/>
                </block>
                <action method="setToolbarBlockName">
                    <argument name="name" xsi:type="string">dynamiccategories.newest.product.list.toolbar</argument>
                </action>
            </block>
        </referenceContainer>
    </body>
</page>

