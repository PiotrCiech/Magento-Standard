<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="rokezzz_promotion_slide" resource="default" engine="innodb" comment="Promotion Slider Slides">
        <column xsi:type="int" name="slide_id" unsigned="true" nullable="false" identity="true" comment="Slide ID"/>
        <column xsi:type="varchar" name="title" nullable="false" length="255" comment="Slide Title"/>
        <column xsi:type="varchar" name="image" nullable="true" length="255" comment="Image Path"/>
        <column xsi:type="varchar" name="btn_left_label" nullable="true" length="255" comment="Left Button Label"/>
        <column xsi:type="varchar" name="btn_left_url" nullable="true" length="255" comment="Left Button URL"/>
        <column xsi:type="varchar" name="btn_right_label" nullable="true" length="255" comment="Right Button Label"/>
        <column xsi:type="varchar" name="btn_right_url" nullable="true" length="255" comment="Right Button URL"/>
        <column xsi:type="varchar" name="counter_left_label" nullable="true" length="255" comment="Left Counter Label"/>
        <column xsi:type="varchar" name="counter_left_number" nullable="true" length="50" comment="Left Counter Number"/>
        <column xsi:type="varchar" name="counter_right_label" nullable="true" length="255" comment="Right Counter Label"/>
        <column xsi:type="varchar" name="counter_right_number" nullable="true" length="50" comment="Right Counter Number"/>
        <column xsi:type="int" name="sort_order" unsigned="true" nullable="false" default="0" comment="Sort Order"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="slide_id"/>
        </constraint>
    </table>
</schema>
