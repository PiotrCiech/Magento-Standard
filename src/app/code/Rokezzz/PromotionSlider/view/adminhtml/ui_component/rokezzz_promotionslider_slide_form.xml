<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">rokezzz_promotionslider_slide_form.rokezzz_promotionslider_slide_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Slide Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="save" class="Rokezzz\PromotionSlider\Block\Adminhtml\Slide\Edit\SaveButton"/>
            <button name="delete" class="Rokezzz\PromotionSlider\Block\Adminhtml\Slide\Edit\DeleteButton"/>
            <button name="back" class="Rokezzz\PromotionSlider\Block\Adminhtml\Slide\Edit\BackButton"/>
        </buttons>
        <namespace>rokezzz_promotionslider_slide_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>rokezzz_promotionslider_slide_form.rokezzz_promotionslider_slide_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="rokezzz_promotionslider_slide_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="rokezzz_promotionslider/slide/save"/>
        </settings>
        <dataProvider class="Rokezzz\PromotionSlider\Model\Slide\DataProvider" name="rokezzz_promotionslider_slide_form_data_source">
            <settings>
                <requestFieldName>slide_id</requestFieldName>
                <primaryFieldName>slide_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="10">
        <settings>
            <collapsible>false</collapsible>
            <label translate="true">General</label>
        </settings>
        <field name="slide_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>
        <field name="title" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Title</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="image" formElement="imageUploader" sortOrder="20">
            <settings>
                <label translate="true">Image</label>
                <componentType>imageUploader</componentType>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <allowedExtensions>jpg jpeg gif png webp</allowedExtensions>
                        <maxFileSize>10485760</maxFileSize>
                        <uploaderConfig>
                            <param name="url" xsi:type="url" path="rokezzz_promotionslider/slide/upload"/>
                        </uploaderConfig>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
        <field name="btn_left_label" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Przycisk lewy - label</label>
            </settings>
        </field>
        <field name="btn_left_url" formElement="input" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Przycisk lewy - URL</label>
            </settings>
        </field>
        <field name="btn_right_label" formElement="input" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Przycisk prawy - label</label>
            </settings>
        </field>
        <field name="btn_right_url" formElement="input" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Przycisk prawy - URL</label>
            </settings>
        </field>
        <field name="counter_left_label" formElement="input" sortOrder="70">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Licznik lewy - label</label>
            </settings>
        </field>
        <field name="counter_left_number" formElement="input" sortOrder="80">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Licznik lewy - number</label>
            </settings>
        </field>
        <field name="counter_right_label" formElement="input" sortOrder="90">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Licznik prawy - label</label>
            </settings>
        </field>
        <field name="counter_right_number" formElement="input" sortOrder="100">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Licznik prawy - number</label>
            </settings>
        </field>
        <field name="sort_order" formElement="input" sortOrder="110">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Sort Order</label>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="is_active" formElement="checkbox" sortOrder="120">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Active</label>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>
</form>
