<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="rokezzz_invoices" translate="label" sortOrder="990" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Rokezzz Invoices</label>
            <tab>general</tab>
            <resource>Rokezzz_Invoices::config</resource>
            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable invoices</label>
                    <comment>When disabled, Polish invoice generation and KSeF integration are turned off.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="ksef" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>KSeF</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable KSeF submission</label>
                    <comment>When enabled, eligible invoices are sent to the National e-Invoice System (KSeF).</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="rokezzz_invoices/general/enabled">1</field>
                    </depends>
                </field>
                <field id="start_date" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>KSeF start date</label>
                    <comment>Only invoices issued on or after this date (YYYY-MM-DD) are submitted to KSeF.</comment>
                    <validate>validate-date</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="files" translate="label" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Files</label>
                <field id="invoices_directory" translate="label comment" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Invoices directory</label>
                    <comment>Relative path inside var/ where invoice XML and UPO files are stored.</comment>
                    <depends>
                        <field id="rokezzz_invoices/general/enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
