<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceContainer name="content">
            <block class="Magento\Contact\Block\ContactForm"
                   name="contactForm"
                   template="Magento_Contact::form.phtml"
                   before="-"/>

            <block class="Magento\Framework\View\Element\Template"
                   name="rokezzz.contact.info"
                   template="Magento_Contact::contact/info.phtml"
                   after="contactForm"/>

            <block class="Magento\Framework\View\Element\Template"
                   name="rokezzz.contact.map"
                   template="Magento_Contact::contact/map.phtml"
                   after="rokezzz.contact.info"/>
        </referenceContainer>
    </body>
</page>
