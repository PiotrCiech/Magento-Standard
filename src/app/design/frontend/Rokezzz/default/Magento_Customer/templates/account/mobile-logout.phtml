?>
<div class="mobile-auth" data-bind="scope: 'customer'">
    <a class="mobile-logout-link" href="<?= $escaper->escapeUrl($logoutUrl) ?>"
        title="<?= $escaper->escapeHtmlAttr(__('Sign Out')) ?>">
        <?= $escaper->escapeHtml(__('Sign Out')) ?>
    </a>
    <a class="mobile-logout-link mobile-login-link" href="<?= $escaper->escapeUrl($loginUrl) ?>"
        title="<?= $escaper->escapeHtmlAttr(__('Sign In')) ?>">
        <?= $escaper->escapeHtml(__('Sign In')) ?>
    </a>
</div>
