<?xml version="1.0"?>
<ruleset name="Rokezzz">
    <description>Rokezzz PHP coding standard for Magento modules.</description>

    <arg name="colors"/>
    <arg name="parallel" value="4"/>
    <arg value="p"/>

    <file>app/code/Rokezzz</file>

    <exclude-pattern>*/generated/*</exclude-pattern>
    <exclude-pattern>*/var/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <rule ref="PSR12"/>
    <rule ref="Magento2"/>
</ruleset>
